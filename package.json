{
  "name": "songbook",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --live-reload false",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "lint": "ng lint",
    "prettier": "npx prettier --write .",
    "generate-song-list": "node scripts/generate-song-list.js",
    "pdf:build": "tsc -p tsconfig.cli.json",
    "pdf": "npm run pdf:build --silent && node dist/cli/scripts/cli/pdf-cli.js",
    "pdf:book": "npm run pdf --silent -- book",
    "pdf:print": "npm run pdf --silent -- print",
    "pdf:history": "npm run pdf --silent -- history",
    "test:watch": "jest --watch",
    "pdf:test": "npm run pdf --silent -- book --assets test-songs --out output/test-spiewnik.pdf"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/router": "^22.2.4",
    "lodash": "^4.17.21",
    "pdfmake": "^0.2.12",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular-eslint/schematics": "22.6.0",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.200",
    "@types/pdfmake": "^0.2.9",
    "angular-eslint": "^22.6.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.3",
    "prettier": "^3.0.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --fix",
    "*.{js,ts,css,scss,html}": "prettier --write"
  }
}
